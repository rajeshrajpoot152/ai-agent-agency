# ==========================================
# POSTGRESQL DATABASE CONFIG (pgAdmin 4)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agency_master
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ==========================================
# AI MODEL CONFIGURATION (GEMINI / OPENAI)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# OUTREACH / WHATSAPP GATEWAY (OPTIONAL)
# ==========================================
# Options: 'console_mock' (for safe testing), 'twilio', 'meta_whatsapp', or 'webhook'
MESSAGING_PROVIDER=console_mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
